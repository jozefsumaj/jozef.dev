---
import BaseLayout from '../layouts/BaseLayout.astro';
import ObservabilityHUD from '../components/ObservabilityHUD';
---

<BaseLayout title="Projects" description="Projects and Experiments">
  <div class="prose">
    <h1>Projects</h1>
    <p>
      This section showcases various projects and experiments.
    </p>
    
    <h2>Observability HUD</h2>
    <p>
        Below (or overlaying the bottom of the screen) is a custom Observability HUD powered by OpenTelemetry. 
        It visualizes traces and spans generated by user interaction and background traffic simulation.
    </p>
  </div>
  
  <ObservabilityHUD client:only="react" />
</BaseLayout>
